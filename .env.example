# Copy to .env.local and fill in. Only NEXT_PUBLIC_* values reach the browser.
# Use the project's *publishable* key (or legacy anon key). Never put a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Set to "true" once Google is configured in the Supabase dashboard (shows the Google button).
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Optional: free USDA FoodData Central key (https://fdc.nal.usda.gov/api-key-signup). Server-only.
FDC_API_KEY=
